          {
            "type": "command",
            "command": "./.engineering/aplomo-runtime hook --source codex --root ."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.engineering/aplomo-runtime hook --source codex --root ."
          }
        ]
      }
    ]
  }
}
