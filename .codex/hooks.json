{
  "description": "Generated by Aplomo from .engineering/config.yaml",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.engineering/aplomo-runtime hook --source codex --root ."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
